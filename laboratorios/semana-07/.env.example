# Copia este archivo como .env y llena tus datos. El .env NO se sube a GitHub.
# Kestra lee las variables ENV_* como {{ envs.snowflake_account }}, etc.
ENV_SNOWFLAKE_ACCOUNT=ORG-CUENTA
ENV_SNOWFLAKE_USER=ELT_USER
ENV_SNOWFLAKE_PASSWORD=pon_aqui_tu_clave
ENV_SNOWFLAKE_ROLE=TRANSFORMER
ENV_SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
ENV_SNOWFLAKE_DATABASE=NYC_TAXI
